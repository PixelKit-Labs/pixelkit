{
  "name": "@pixelkit/cli",
  "version": "1.1.15",
  "description": "Command-line diagnostics for PixelKit. `pixelkit doctor` checks adb, the connected device, the installed development build and workspace package resolution so a source: 'unavailable' reading is not mistaken for a bug.",
  "keywords": [
    "pixelkit",
    "cli",
    "diagnostics",
    "android",
    "pixel"
  ],
  "license": "MIT",
  "author": "Traves Theberge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelKit-Labs/pixelkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/PixelKit-Labs/pixelkit#readme",
  "bugs": {
    "url": "https://github.com/PixelKit-Labs/pixelkit/issues"
  },
  "bin": {
    "pixelkit": "./build/index.js"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync(process.argv[1],{recursive:true,force:true})\" build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
