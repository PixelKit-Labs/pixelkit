# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
packages/**/build/
.gradle/

# HiLight daemon build output (run.ps1 rebuilds the jar when it is missing)
scripts/hilight-daemon/build/
scripts/hilight-daemon/*.jar

# Workspace package build output
packages/*/build/
*.tgz

# Agent worktrees are scratch checkouts of this repo, never content
.claude/worktrees/

# docs/ that scripts/sync-docs.mjs writes before every dev/build run (docs/ stays the source
# of truth; this copy must never be committed).

# Cloned by scripts/check-docs-contract.js to verify the docs repo against this source
.pixelkit-docs/

# archify visual-check evidence: screenshots and receipts, regenerated on demand
docs/*.visual-check.*
