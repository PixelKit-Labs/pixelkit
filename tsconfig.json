{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@pixelkit-labs/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@pixelkit-labs/native": [
        "./packages/native/index.ts"
      ],
      "@pixelkit-labs/mlkit": [
        "./packages/mlkit/index.ts"
      ],
      "@pixelkit-labs/sdk/mlkit": [
        "./packages/sdk/src/mlkit.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/index.ts",
    "test/**/*"
  ]
}
