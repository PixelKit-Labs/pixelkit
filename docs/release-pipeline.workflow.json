{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "PixelKit Release Pipeline",
    "output": "docs/release-pipeline.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "set-and-verify",
        "label": "Version and verify",
        "focus": [
          "sync",
          "verify",
          "docs_repo",
          "tag"
        ],
        "note": "One version across four manifests, then the checks that must pass before a tag exists."
      },
      {
        "id": "tag-to-registry",
        "label": "Tag to registry",
        "focus": [
          "tag",
          "release",
          "npm",
          "no_token"
        ],
        "note": "The tag must match every manifest, and the three packages publish in dependency order."
      },
      {
        "id": "reaching-template",
        "label": "Reaching the template",
        "focus": [
          "npm",
          "dependabot",
          "parity"
        ],
        "note": "How a published SDK arrives in the template, and what decides whether it may land."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "frontend": {
          "label": "Maintainer action"
        },
        "backend": {
          "label": "CI job"
        },
        "database": {
          "label": "Sibling repository"
        },
        "cloud": {
          "label": "Registry"
        },
        "security": {
          "label": "Blocking gate"
        },
        "messagebus": {
          "label": "Automation"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "maintainer",
      "label": "Maintainer"
    },
    {
      "id": "sdk_ci",
      "label": "pixelkit-sdk CI"
    },
    {
      "id": "registry",
      "label": "npm registry"
    },
    {
      "id": "template",
      "label": "pixelkit-template"
    }
  ],
  "phases": [
    {
      "id": "prepare",
      "label": "Prepare",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "rel",
      "label": "Tag + publish",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "prop",
      "label": "Propagate",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "sync",
    "verify",
    "tag",
    "release",
    "npm",
    "dependabot",
    "parity"
  ],
  "nodes": [
    {
      "id": "sync",
      "lane": "maintainer",
      "col": 0,
      "type": "frontend",
      "label": "Set the version",
      "sublabel": "sync-versions.js",
      "tag": "4 manifests",
      "width": 100
    },
    {
      "id": "verify",
      "lane": "sdk_ci",
      "col": 1,
      "type": "backend",
      "label": "verify.yml",
      "sublabel": "build, pack, resolve",
      "tag": "every push",
      "width": 98
    },
    {
      "id": "docs_repo",
      "lane": "sdk_ci",
      "col": 0,
      "type": "database",
      "label": "pixelkit-docs",
      "sublabel": "cloned by check-docs",
      "width": 100
    },
    {
      "id": "tag",
      "lane": "maintainer",
      "col": 2,
      "type": "frontend",
      "label": "Push tag",
      "sublabel": "v<version>",
      "width": 80
    },
    {
      "id": "release",
      "lane": "sdk_ci",
      "col": 3,
      "type": "security",
      "label": "release.yml",
      "sublabel": "tag must match all four",
      "tag": "blocking",
      "width": 100
    },
    {
      "id": "npm",
      "lane": "registry",
      "col": 4,
      "type": "cloud",
      "label": "npm publish",
      "sublabel": "native, mlkit, sdk",
      "tag": "--provenance",
      "width": 108
    },
    {
      "id": "dependabot",
      "lane": "template",
      "col": 4,
      "type": "messagebus",
      "label": "Dependabot",
      "sublabel": "daily, grouped",
      "width": 90
    },
    {
      "id": "parity",
      "lane": "template",
      "col": 5,
      "type": "security",
      "label": "Parity gate",
      "sublabel": "against node_modules",
      "tag": "names the hook",
      "width": 100
    },
    {
      "id": "no_token",
      "lane": "registry",
      "col": 3,
      "type": "security",
      "label": "PIXELKIT secret",
      "sublabel": "nothing published",
      "width": 98
    }
  ],
  "edges": [
    {
      "from": "sync",
      "to": "verify",
      "label": "push to master"
    },
    {
      "from": "docs_repo",
      "to": "verify",
      "label": "every hook documented",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "from": "verify",
      "to": "tag",
      "label": "green",
      "variant": "emphasis"
    },
    {
      "from": "tag",
      "to": "release",
      "label": "tags: v*"
    },
    {
      "from": "release",
      "to": "npm",
      "label": "in dependency order",
      "variant": "emphasis"
    },
    {
      "from": "release",
      "to": "no_token",
      "label": "cannot publish",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "npm",
      "to": "dependabot",
      "label": "one pull request"
    },
    {
      "from": "dependabot",
      "to": "parity",
      "label": "CI decides"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Where it stands",
      "items": [
        "@pixelkit-labs/native and @pixelkit-labs/mlkit are published with provenance",
        "npm rejected the unscoped name pixelkit as too similar to pixel-kit, so the SDK is @pixelkit-labs/sdk"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the gates prove",
      "items": [
        "verify.yml resolves both entries from a packed tarball, so the exports map is checked, not assumed",
        "check-docs clones pixelkit-docs: an undocumented export fails the build",
        "release.yml refuses a tag that disagrees with any of the four manifests",
        "pixelkit-cli releases @pixelkit-labs/cli from its own repo, on its own schedule"
      ]
    }
  ]
}
